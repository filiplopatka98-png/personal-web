---
import { t, type Lang } from '../i18n';
import AvailabilityPill from './AvailabilityPill.astro';
import NowPlaying from './NowPlaying.astro';

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeHref = lang === 'sk' ? `${baseUrl}/` : `${baseUrl}/en/`;
---
<nav
  class="nav-bar"
  aria-label="Primary"
>
  <a href={homeHref} class="nav-logo">
    <span class="nav-logo-dot" aria-hidden="true"></span>
    <span class="nav-logo-text">Filip Lopatka</span>
  </a>

  <div class="nav-now">
    <NowPlaying lang={lang} />
  </div>

  <div class="nav-right">
    <div class="nav-pill">
      <AvailabilityPill lang={lang} />
    </div>
    <button
      type="button"
      data-cursor="hover"
      data-menu-open
      aria-label={t('nav.openMenu', lang)}
      aria-haspopup="dialog"
      aria-controls="overlay-menu"
      aria-expanded="false"
      class="nav-menu-btn"
    >
      <span class="nav-menu-bars" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
      {t('nav.menu', lang)}
    </button>
  </div>
</nav>

<style>
  .nav-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 56px;
    border-bottom: 1px solid transparent;
    position: sticky;
    top: 0;
    /* Material: translucent white over scrolling content; the hairline only
       appears once content actually scrolls under the bar (scroll edge). */
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    backdrop-filter: blur(16px) saturate(180%);
    transition: border-color 0.2s;
    z-index: 50;
  }

  .nav-bar.is-scrolled { border-bottom-color: color-mix(in srgb, var(--ink) 14%, transparent); }
  @media (prefers-reduced-transparency: reduce) {
    .nav-bar { background: var(--bg); -webkit-backdrop-filter: none; backdrop-filter: none; }
  }
  @media (prefers-contrast: more) {
    .nav-bar { background: var(--bg); border-bottom-color: var(--ink); }
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ink);
  }

  .nav-logo-dot {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }

  .nav-logo-text {
    font-size: 17px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .nav-now {
    display: flex;
    align-items: center;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .nav-menu-btn {
    background: var(--ink);
    color: var(--bg);
    border: 0;
    padding: 12px 18px;
    border-radius: 0;
    font-size: 15px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
  }

  .nav-menu-bars {
    display: inline-flex;
    flex-direction: column;
    gap: 3px;
  }

  .nav-menu-bars span {
    width: 14px;
    height: 1.5px;
    background: var(--bg);
  }

  /* Tablet: hide the noisy "TERAZ pracujem na…" indicator; keep status pill. */
  @media (max-width: 1024px) {
    .nav-bar {
      padding: 18px 32px;
    }
    .nav-now {
      display: none;
    }
  }

  /* Mobile: hide both .nav-now and .nav-pill, drop "Menu" text label. */
  @media (max-width: 768px) {
    .nav-bar {
      padding: 14px 20px;
      flex-wrap: wrap;
      gap: 12px;
    }
    .nav-now,
    .nav-pill {
      display: none;
    }
    /* Drop the "Menu" word — keep only the icon — saves precious horizontal space. */
    .nav-menu-btn {
      padding: 10px 14px;
      font-size: 0;
      gap: 0;
    }
    .nav-menu-bars {
      gap: 4px;
    }
    .nav-menu-bars span {
      width: 18px;
    }
  }
</style>

<script>
  // Scroll edge: show the hairline under the translucent bar only once content
  // is actually underneath it. Passive listener, rAF-throttled.
  function initNavEdge() {
    const nav = document.querySelector<HTMLElement>('.nav-bar');
    if (!nav || nav.dataset.edge) return;
    nav.dataset.edge = '1';
    let ticking = false;
    const update = () => { nav.classList.toggle('is-scrolled', window.scrollY > 4); ticking = false; };
    update();
    window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
  }
  initNavEdge();
  document.addEventListener('astro:page-load', initNavEdge);
</script>
