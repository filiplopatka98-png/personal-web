---
import { t, type Lang } from '../i18n';
import Reveal from './Reveal.astro';
import { WEB3FORMS_ACCESS_KEY } from '../config';
import { PRICES, fromPrice } from '../data/pricing';

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const titleHtml = `${t('brief.title.before', lang)}<em class="brief-h1-em">${t('brief.title.em', lang)}</em>${t('brief.title.after', lang)}`;

const types = lang === 'sk' ? [
  { k: 'web', name: 'Firemný web', sub: `${fromPrice(PRICES.web, 'sk')} · 2–4 týždne` },
  { k: 'eshop', name: 'E-shop na WooCommerce', sub: `${fromPrice(PRICES.eshop, 'sk')} · 4–8 týždňov` },
  { k: 'speed', name: 'Zrýchlenie webu', sub: `${fromPrice(PRICES.speed, 'sk')} · 1–2 týždne` },
  { k: 'audit', name: 'Kontrola webu zadarmo', sub: 'do 2 pracovných dní' },
  { k: 'other', name: 'Niečo iné', sub: 'Povedzme si' },
] : [
  { k: 'web', name: 'Company website', sub: `${fromPrice(PRICES.web, 'en')} · 2–4 weeks` },
  { k: 'eshop', name: 'WooCommerce store', sub: `${fromPrice(PRICES.eshop, 'en')} · 4–8 weeks` },
  { k: 'speed', name: 'Website speed-up', sub: `${fromPrice(PRICES.speed, 'en')} · 1–2 weeks` },
  { k: 'audit', name: 'Free website check', sub: 'within 2 business days' },
  { k: 'other', name: 'Something else', sub: "Let's talk" },
];

const budgets = lang === 'sk' ? [
  { k: 'lt500', label: 'Do 500 €' },
  { k: '500-1500', label: '500 – 1 500 €' },
  { k: '1500-3000', label: '1 500 – 3 000 €' },
  { k: 'gt3000', label: 'Nad 3 000 €' },
  { k: 'unknown', label: 'Ešte neviem' },
] : [
  { k: 'lt500', label: 'Under €500' },
  { k: '500-1500', label: '€500–1,500' },
  { k: '1500-3000', label: '€1,500–3,000' },
  { k: 'gt3000', label: 'Over €3,000' },
  { k: 'unknown', label: 'Not sure yet' },
];

const timelines = lang === 'sk' ? [
  { k: 'asap', label: 'Čím skôr' },
  { k: '1-3m', label: '1–3 mesiace' },
  { k: '3-6m', label: '3–6 mesiacov' },
  { k: 'flex', label: 'Flexibilný' },
] : [
  { k: 'asap', label: 'ASAP' },
  { k: '1-3m', label: '1–3 months' },
  { k: '3-6m', label: '3–6 months' },
  { k: 'flex', label: 'Flexible' },
];

// Budget filter — if a project type's starting price exceeds the chosen
// budget ceiling, a tactful non-blocking notice appears on the next step.
// Data-driven: adjust prices/ceilings and the rule follows.
const TYPE_MIN_PRICE: Record<string, number> = {
  web: PRICES.web, eshop: PRICES.eshop, speed: PRICES.speed, audit: 0, other: 0,
};
const BUDGET_CEILING: Record<string, number> = {
  lt500: 500, '500-1500': 1500, '1500-3000': 3000, gt3000: 1e9, unknown: 1e9,
};

const budgetWarn = lang === 'sk' ? {
  title: 'Krátko a na rovinu.',
  intro: 'V tomto rozpočte vám neviem dodať projekt v kvalite, za ktorú by som vedel ručiť — rýchly, spoľahlivý a poriadne postavený. Radšej to poviem hneď, než by som sľuboval niečo, čo by vás neskôr mrzelo.',
  options: [
    { label: 'Fázovanie', text: 'spustíme menší funkčný základ a rozširujeme postupne.' },
    { label: 'Jednoduchšie riešenie', text: `napr. menší web ${fromPrice(PRICES.web, 'sk')}, ktorý dá zmysel hneď.` },
    { label: 'Ozvite sa aj tak', text: 'ak mám niečo pochopené inak, napíšte a povieme si to narovinu.' },
  ],
  closer: 'Pokojne dokončite formulár — ozvem sa a nájdeme cestu, ktorá dáva zmysel.',
} : {
  title: 'Straight talk.',
  intro: "On this budget I can't deliver a project at a quality I'd stand behind — fast, reliable, properly built. I'd rather say so upfront than promise something you'd regret later.",
  options: [
    { label: 'Phase it', text: 'launch a smaller working core and grow it step by step.' },
    { label: 'Simpler solution', text: `e.g. a smaller site ${fromPrice(PRICES.web, 'en')} that makes sense right now.` },
    { label: 'Reach out anyway', text: "if I've got something wrong, drop me a line and we'll talk it straight." },
  ],
  closer: "Feel free to finish the form — I'll get back to you and we'll find a way that makes sense.",
};

const stepLabels = [
  t('brief.step.0', lang),
  t('brief.step.1', lang),
  t('brief.step.2', lang),
  t('brief.step.3', lang),
  t('brief.step.4', lang),
  t('brief.step.5', lang),
];

const CONTACT_EMAIL = t('menu.email', lang);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeHref = lang === 'sk' ? `${baseUrl}/` : `${baseUrl}/en/`;
// Own inline validation messages (no browser bubbles) — one per field/step.
const M = lang === 'sk' ? {
  typeRequired: 'Vyberte typ projektu, aby som vedel, s čím vám pomôcť.',
  budgetRequired: 'Vyberte približný rozpočet — pokojne aj „Ešte neviem“.',
  timelineRequired: 'Vyberte termín — pokojne aj „Flexibilný“.',
  descriptionRequired: 'Napíšte pár viet o projekte — čo robíte a čo od webu čakáte.',
  descriptionShort: 'Ešte trochu — aspoň {min} znakov (zatiaľ {n}).',
  nameRequired: 'Napíšte, prosím, svoje meno.',
  emailRequired: 'Zadajte e-mail, na ktorý vám pošlem návrh.',
  emailInvalid: 'Tento e-mail nevyzerá správne — skontrolujte zavináč a doménu.',
  emailSuggest: 'Mysleli ste {email}?',
} : {
  typeRequired: 'Pick a project type so I know what you need.',
  budgetRequired: 'Pick a rough budget — “Not sure yet” is fine too.',
  timelineRequired: 'Pick a timeline — “Flexible” is fine too.',
  descriptionRequired: 'Write a few sentences about the project — what you do and what the site should achieve.',
  descriptionShort: 'A bit more — at least {min} characters (now {n}).',
  nameRequired: 'Please tell me your name.',
  emailRequired: 'Enter the e-mail I should send the proposal to.',
  emailInvalid: "This e-mail doesn't look right — check the @ and the domain.",
  emailSuggest: 'Did you mean {email}?',
};
---
<div
  class="brief-wizard"
  data-step="0"
  data-contact-email={CONTACT_EMAIL}
  data-w3f-key={WEB3FORMS_ACCESS_KEY}
  data-subject-prefix={t('brief.subject', lang)}
  data-sending={t('brief.btn.sending', lang)}
  data-error={t('brief.error', lang)}
  data-validation={t('brief.validation', lang)}
  data-price-check={JSON.stringify({ types: TYPE_MIN_PRICE, ceilings: BUDGET_CEILING })}
  data-msg-type-required={M.typeRequired}
  data-msg-budget-required={M.budgetRequired}
  data-msg-timeline-required={M.timelineRequired}
  data-msg-description-required={M.descriptionRequired}
  data-msg-description-short={M.descriptionShort}
  data-msg-name-required={M.nameRequired}
  data-msg-email-required={M.emailRequired}
  data-msg-email-invalid={M.emailInvalid}
  data-msg-email-suggest={M.emailSuggest}
  data-draft-key={`brief-draft-${lang}`}
>
  {/* Header section — handoff line 442: 60/56/32, border-bottom 1px ink1f */}
  <section class="brief-header">
    <Reveal>
      <div class="brief-eyebrow mono">{t('brief.eyebrow', lang)}</div>
      <h1 class="brief-h1 display" set:html={titleHtml}></h1>
      <p class="brief-lead">{t('brief.lead', lang)}</p>
    </Reveal>

    {/* Progress indicator — handoff line 451: marginTop 48, gap 8, in header section */}
    <div class="brief-progress">
      {stepLabels.map((label, i) => (
        <Fragment>
          <div class="brief-progress-step" data-step-index={i}>
            <div class="brief-progress-dot">{i + 1}</div>
            <div class="brief-progress-label mono">{label}</div>
          </div>
          {i < stepLabels.length - 1 && <div class="brief-progress-line" data-line-index={i}></div>}
        </Fragment>
      ))}
    </div>
  </section>

  {/* Body — handoff line 464: 60/56, minHeight 500, max-width 760 inner */}
  <section class="brief-body">
    <form class="brief-form" novalidate>
    <!-- Web3Forms honeypot: real users leave this empty; bots that fill it get rejected. -->
    <input type="checkbox" name="botcheck" class="brief-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />

    {/* Budget-vs-type notice — shown by JS on later steps when the chosen
        budget can't realistically cover the selected project type. */}
    <aside class="brief-budget-warn" data-budget-warn role="note" hidden>
      <div class="brief-budget-warn-title mono">{budgetWarn.title}</div>
      <p class="brief-budget-warn-intro">{budgetWarn.intro}</p>
      <ul class="brief-budget-warn-list">
        {budgetWarn.options.map((o) => (
          <li><strong>{o.label}</strong> — {o.text}</li>
        ))}
      </ul>
      <p class="brief-budget-warn-closer">{budgetWarn.closer}</p>
    </aside>

    <!-- Step 0: Type -->
    <fieldset class="brief-step" data-step="0" aria-labelledby="brief-q-0">
      <h2 class="brief-q display" id="brief-q-0" tabindex="-1">{t('brief.q.type', lang)}</h2>
      <div class="brief-options" data-field data-choice="type">
        {types.map((opt) => (
          <label class="brief-radio">
            <input type="radio" name="type" value={opt.k} required />
            <div class="brief-radio-content">
              <div class="brief-radio-name display">{opt.name}</div>
              <div class="brief-radio-sub mono">{opt.sub}</div>
            </div>
            <div class="brief-radio-check" aria-hidden="true">✓</div>
          </label>
        ))}
      </div>
    </fieldset>

    <!-- Step 1: Budget -->
    <fieldset class="brief-step" data-step="1" aria-labelledby="brief-q-1" hidden>
      <h2 class="brief-q display" id="brief-q-1" tabindex="-1">{t('brief.q.budget', lang)}</h2>
      <p class="brief-q-sub">{t('brief.q.budget.sub', lang)}</p>
      <div class="brief-grid" data-field data-choice="budget">
        {budgets.map((opt) => (
          <label class="brief-tile">
            <input type="radio" name="budget" value={opt.k} required />
            <div class="brief-tile-label display">{opt.label}</div>
          </label>
        ))}
      </div>
    </fieldset>

    <!-- Step 2: Timeline -->
    <fieldset class="brief-step" data-step="2" aria-labelledby="brief-q-2" hidden>
      <h2 class="brief-q display" id="brief-q-2" tabindex="-1">{t('brief.q.timeline', lang)}</h2>
      <div class="brief-grid" data-field data-choice="timeline">
        {timelines.map((opt) => (
          <label class="brief-tile">
            <input type="radio" name="timeline" value={opt.k} required />
            <div class="brief-tile-label display">{opt.label}</div>
          </label>
        ))}
      </div>
    </fieldset>

    <!-- Step 3: Description -->
    <fieldset class="brief-step" data-step="3" hidden>
      <h2 class="brief-q display" id="brief-desc-label" tabindex="-1">{t('brief.q.desc', lang)}</h2>
      <div data-field>
      <textarea
        name="description"
        id="brief-desc"
        aria-labelledby="brief-desc-label"
        rows="10"
        required
        minlength="10"
        placeholder={t('brief.placeholder.desc', lang)}
        class="brief-textarea"
      ></textarea>
      <div class="brief-char-count mono"><span data-char-count>0</span> {t('brief.label.chars', lang)} (min. 10)</div>
      </div>
    </fieldset>

    <!-- Step 4: Contact -->
    <fieldset class="brief-step" data-step="4" hidden>
      <h2 class="brief-q display" id="brief-q-4" tabindex="-1">{t('brief.q.contact', lang)}</h2>
      <div class="brief-fields">
        <div class="brief-field" data-field>
          <label for="brief-name" class="brief-field-label mono">{t('brief.label.name', lang)}</label>
          <input type="text" name="name" id="brief-name" required autocomplete="name" class="brief-input" />
        </div>
        <div class="brief-field" data-field>
          <label for="brief-email" class="brief-field-label mono">{t('brief.label.email', lang)}</label>
          <input type="email" name="email" id="brief-email" required autocomplete="email" class="brief-input" />
        </div>
        <div class="brief-field">
          <label for="brief-company" class="brief-field-label mono">{t('brief.label.company', lang)}</label>
          <input type="text" name="company" id="brief-company" autocomplete="organization" class="brief-input" />
        </div>
      </div>
    </fieldset>

    <!-- Step 5: Done -->
    <fieldset class="brief-step" data-step="5" hidden>
      <div class="brief-done">
        <div class="brief-done-icon">✦</div>
        <h2 class="brief-done-title display" tabindex="-1">{t('brief.done.title', lang)}</h2>
        <p class="brief-done-body">{t('brief.done.body', lang)}</p>
        <a href={homeHref} class="brief-done-back mono" data-cursor="hover">← {t('brief.done.back', lang)}</a>
      </div>
    </fieldset>

    <!-- Nav buttons -->
    <div class="brief-nav" data-nav>
      <button type="button" data-cursor="hover" data-back class="brief-btn-back" disabled>← {t('brief.btn.back', lang)}</button>
      <button type="button" data-cursor="hover" data-next class="brief-btn-next">{t('brief.btn.continue', lang)} →</button>
      <button type="submit" data-cursor="hover" data-submit data-umami-event="brief-submit" class="brief-btn-submit" hidden>{t('brief.btn.send', lang)} →</button>
    </div>
    <p class="brief-error mono" data-error role="alert" hidden></p>
    </form>
  </section>
</div>

<style>
  .brief-wizard {
    display: flex;
    flex-direction: column;
  }

  /* Header section — handoff line 442: 60/56/32, border-bottom 1px ink1f */
  .brief-header {
    padding: 60px 56px 32px;
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
  }
  .brief-eyebrow {
    font-size: 13px;
    opacity: 0.78;
    margin-bottom: 14px;
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
  }
  /* h1 — 108px to match every other interior page H1 (PageHead). */
  .brief-h1 {
    font-size: 108px;
    line-height: 0.95;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.02em;
    max-width: 900px;
  }
  .brief-h1 :global(.brief-h1-em) {
    color: var(--accent-text);
    font-style: normal;
  }
  /* Lead — handoff line 447: 18 1.45 0.7 max 560 marginTop 24 */
  .brief-lead {
    font-size: 18px;
    line-height: 1.45;
    opacity: 0.7;
    max-width: 560px;
    margin-top: 24px;
  }

  /* Body — handoff line 464: 60/56, minHeight 500, max-width 760 inner */
  .brief-body {
    padding: 60px 56px;
    min-height: 500px;
  }
  .brief-form {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  /* Progress indicator — handoff line 451: marginTop 48, gap 8, in header */
  .brief-progress {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-top: 48px;
  }
  .brief-progress-step {
    display: flex;
    align-items: center;
    gap: 10px;
    opacity: 0.7;
    transition: opacity 0.2s;
  }
  .brief-progress-step[data-step-index="0"] { opacity: 1; }
  .brief-progress-dot {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--ink);
    border: 1px solid var(--ink);
    color: var(--bg);
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-size: 12px;
    transition: all 0.2s;
  }
  .brief-progress-label {
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .brief-progress-line {
    flex: 1;
    height: 1px;
    background: color-mix(in srgb, var(--ink) 22%, transparent);
    max-width: 40px;
    transition: background 0.2s;
  }

  .brief-step {
    border: 0;
    padding: 0;
    margin: 0;
  }

  .brief-q {
    font-size: 48px;
    margin: 0 0 32px;
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .brief-q-sub {
    opacity: 0.7;
    margin: -16px 0 24px;
    font-size: 15px;
  }

  /* Step 0 — radio list */
  .brief-options {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .brief-radio {
    cursor: pointer;
    padding: 20px 24px;
    border-radius: var(--radius-card);
    border: 1.5px solid color-mix(in srgb, var(--ink) 22%, transparent);
    background: transparent;
    color: var(--ink);
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: all 0.2s;
  }
  .brief-radio input { position: absolute; opacity: 0; pointer-events: none; }
  /* The real radio is visually hidden, so surface keyboard focus on the tile. */
  .brief-radio:has(input:focus-visible),
  .brief-tile:has(input:focus-visible) {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }
  .brief-radio:hover { border-color: color-mix(in srgb, var(--ink) 50%, transparent); }
  .brief-radio:has(input:checked) {
    border-color: var(--ink);
    background: var(--accent);
  }
  .brief-radio-name {
    font-size: 24px;
    font-family: var(--font-display);
    font-weight: 800;
    line-height: 1.1;
  }
  .brief-radio-sub {
    font-size: 12px;
    opacity: 0.78;
    margin-top: 4px;
    font-family: var(--font-mono);
  }
  .brief-radio-check {
    color: var(--ink);
    font-size: 24px;
    opacity: 0;
  }
  .brief-radio:has(input:checked) .brief-radio-check { opacity: 1; }

  /* Step 1, 2 — tile grid */
  .brief-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 12px;
  }
  .brief-tile {
    cursor: pointer;
    padding: 24px;
    border-radius: var(--radius-card);
    border: 1.5px solid color-mix(in srgb, var(--ink) 22%, transparent);
    background: transparent;
    color: var(--ink);
    transition: all 0.2s;
  }
  .brief-tile input { position: absolute; opacity: 0; pointer-events: none; }
  .brief-tile:hover { border-color: color-mix(in srgb, var(--ink) 50%, transparent); }
  .brief-tile:has(input:checked) {
    border-color: var(--ink);
    background: var(--accent);
  }
  .brief-tile-label {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 22px;
  }

  /* Step 3 — textarea */
  .brief-textarea {
    width: 100%;
    padding: 20px;
    border-radius: var(--radius-card);
    border: 1.5px solid color-mix(in srgb, var(--ink) 22%, transparent);
    background: var(--bg2);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.5;
    resize: vertical;
    outline: none;
  }
  .brief-textarea:focus { border-color: var(--ink); background: var(--bg); box-shadow: 0 0 0 4px var(--accent); }
  /* Restore a visible keyboard-focus ring (outline was suppressed above). */
  .brief-textarea:focus-visible { outline: none; }
  .brief-char-count {
    font-family: var(--font-mono);
    font-size: 12px;
    opacity: 0.78;
    margin-top: 8px;
  }

  /* Step 4 — fields */
  .brief-fields {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .brief-field-label {
    font-family: var(--font-mono);
    font-size: 12px;
    opacity: 0.78;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .brief-input {
    width: 100%;
    background: transparent;
    border: 0;
    border-bottom: 1.5px solid color-mix(in srgb, var(--ink) 33%, transparent);
    color: var(--ink);
    padding: 10px 0;
    font-family: var(--font-body);
    font-size: 20px;
    margin-top: 6px;
    outline: none;
  }
  .brief-input:focus { border-bottom-color: var(--ink); border-bottom-width: 2px; box-shadow: 0 6px 0 -3px var(--accent); }
  /* Restore a visible keyboard-focus ring (outline was suppressed above). */
  .brief-input:focus-visible { outline: none; }

  /* Step 5 — done */
  .brief-done {
    text-align: center;
    padding: 60px 0;
  }
  .brief-done-icon {
    font-size: 80px;
    margin-bottom: 24px;
    color: var(--accent);
  }
  .brief-done-title {
    font-size: 64px;
    margin: 0 0 20px;
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .brief-done-body {
    font-size: 18px;
    opacity: 0.7;
    max-width: 480px;
    margin: 0 auto 32px;
  }
  .brief-done-back {
    display: inline-block;
    background: var(--ink);
    color: var(--bg);
    padding: 14px 24px;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 13px;
    text-decoration: none;
  }

  /* Honeypot — visually and semantically hidden, kept in the DOM for bots. */
  .brief-honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  /* Submit error — shown inline when the Web3Forms POST fails. */
  .brief-error {
    margin: 0;
    color: var(--accent-text);
    font-size: 13px;
    line-height: 1.5;
  }

  /* Budget-vs-type notice — soft accent card, deliberately not an alarm. */
  .brief-budget-warn {
    margin: 0 0 8px;
    padding: 20px 24px;
    background: color-mix(in srgb, var(--accent) 8%, var(--bg));
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    border-radius: var(--radius-card);
    font-size: 15px;
    line-height: 1.6;
  }
  .brief-budget-warn-title {
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-text);
    margin-bottom: 10px;
  }
  .brief-budget-warn-intro { margin: 0 0 12px; }
  .brief-budget-warn-list {
    list-style: none;
    padding: 0;
    margin: 0 0 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .brief-budget-warn-list li { padding-left: 18px; position: relative; }
  .brief-budget-warn-list li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--accent);
  }
  .brief-budget-warn-list strong { font-weight: 600; }
  .brief-budget-warn-closer { margin: 0; opacity: 0.85; }

  /* Nav buttons */
  .brief-nav {
    margin-top: 16px;
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .brief-btn-back {
    padding: 14px 20px;
    border: 1px solid color-mix(in srgb, var(--ink) 33%, transparent);
    background: transparent;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ink);
    cursor: pointer;
  }
  .brief-btn-back:disabled { opacity: 0.5; cursor: default; }
  /* Primary action — ink background / cream text like every other primary CTA
     on a light bg (.btn-primary / .final-cta-btn), accent on hover. */
  .brief-btn-next, .brief-btn-submit {
    padding: 14px 28px;
    border: 0;
    background: var(--ink);
    color: var(--bg);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 13px;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .brief-btn-next:hover, .brief-btn-submit:hover {
    background: var(--accent);
    color: var(--ink);
  }
  .brief-btn-submit[aria-busy="true"] { cursor: progress; }
  .brief-btn-next:disabled, .brief-btn-submit:disabled {
    background: color-mix(in srgb, var(--ink) 22%, transparent);
    color: var(--ink);
    opacity: 0.65;
    cursor: default;
  }

  @media (max-width: 1024px) {
    .brief-header { padding: 48px 32px 32px; }
    .brief-body { padding: 48px 32px; }
    .brief-h1 { font-size: 86px; }
    .brief-q { font-size: 40px; }
    .brief-grid { grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); }
  }
  @media (max-width: 768px) {
    .brief-header { padding: 40px 20px 24px; }
    .brief-body { padding: 40px 20px; }
    .brief-h1 { font-size: 60px; line-height: 0.98; }
    .brief-lead { font-size: 16px; }
    .brief-q { font-size: 32px; }
    /* Progress wraps + lines hidden so dots stack cleanly. */
    .brief-progress { flex-wrap: wrap; row-gap: 16px; margin-top: 32px; }
    .brief-progress-line { display: none; }
    .brief-done-title { font-size: 40px; }
    /* Tile grid → 1-col on mobile so labels don't truncate. */
    .brief-grid { grid-template-columns: 1fr; }
    /* Tighter button spacing per RESPONSIVE.md. */
    .brief-nav { gap: 8px; }
  }
  @media (max-width: 480px) {
    .brief-header { padding: 32px 16px 24px; }
    .brief-body { padding: 32px 16px; }
    .brief-h1 { font-size: 48px; }
    .brief-q { font-size: 28px; }
    .brief-done-title { font-size: 32px; }
    .brief-tile { padding: 18px; }
    .brief-tile-label { font-size: 18px; }
  }
</style>

<script>
  import { validateFields, liveRevalidate, readMessages, setFieldError, clearFieldError, scrollIntoViewSoft, attachEmailSuggest, restoreDraft, persistDraft, clearDraft } from '../scripts/form-errors';

  function initBriefWizard() {
    const wizard = document.querySelector<HTMLElement>('.brief-wizard');
    if (!wizard) return;
    if ((wizard as any).__briefInitialized) return;
    (wizard as any).__briefInitialized = true;

    const form = wizard.querySelector('form') as HTMLFormElement;
    const fieldsets = wizard.querySelectorAll<HTMLFieldSetElement>('.brief-step');
    const progressSteps = wizard.querySelectorAll<HTMLElement>('.brief-progress-step');
    const progressLines = wizard.querySelectorAll<HTMLElement>('.brief-progress-line');
    const backBtn = wizard.querySelector<HTMLButtonElement>('[data-back]');
    const nextBtn = wizard.querySelector<HTMLButtonElement>('[data-next]');
    const submitBtn = wizard.querySelector<HTMLButtonElement>('[data-submit]');
    const navWrap = wizard.querySelector<HTMLElement>('[data-nav]');
    const charCounter = wizard.querySelector<HTMLElement>('[data-char-count]');
    const textarea = wizard.querySelector<HTMLTextAreaElement>('textarea[name="description"]');
    const budgetWarnEl = wizard.querySelector<HTMLElement>('[data-budget-warn]');
    let priceCheck: { types: Record<string, number>; ceilings: Record<string, number> } = { types: {}, ceilings: {} };
    try { priceCheck = JSON.parse(wizard.dataset.priceCheck || '{}'); } catch { /* keep defaults */ }

    let step = 0;
    const lastInputStep = 4; // step 4 is last input, 5 is done
    const msgs = readMessages(wizard);
    const textFields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('textarea[required], input[required]:not([type="radio"])'));
    liveRevalidate(textFields, msgs);
    const emailInput = form.querySelector<HTMLInputElement>('input[type="email"]');
    if (emailInput) attachEmailSuggest(emailInput, msgs.emailSuggest || '');

    // Draft: a reload or a quick detour doesn't wipe what was already filled in.
    const draftKey = wizard.dataset.draftKey || 'brief-draft';
    const draft = restoreDraft(form, draftKey);

    // Preselect project type from ?typ= (e.g. Google profile offer → /ponuka/?typ=audit,
    // calculator CTA → ?typ=eshop). The type is then already answered, so skip step 0.
    const preType = new URLSearchParams(location.search).get('typ');
    let preTypeOk = false;
    if (preType) {
      const r = form.querySelector<HTMLInputElement>(`input[name="type"][value="${CSS.escape(preType)}"]`);
      if (r) { r.checked = true; preTypeOk = true; }
    }

    // Never land past the first unanswered step (e.g. a stale saved step).
    function firstIncompleteStep(): number {
      for (const name of ['type', 'budget', 'timeline']) {
        if (!form.querySelector(`input[name="${name}"]:checked`)) return ['type', 'budget', 'timeline'].indexOf(name);
      }
      if ((textarea?.value.trim().length ?? 0) < 10) return 3;
      return lastInputStep;
    }
    const savedStep = parseInt(draft?.__step ?? '', 10);
    if (!Number.isNaN(savedStep)) step = Math.min(Math.max(savedStep, 0), lastInputStep, firstIncompleteStep());
    if (preTypeOk && step === 0) step = 1;
    if (charCounter && textarea) charCounter.textContent = String(textarea.value.length);
    const saveDraft = persistDraft(form, draftKey, () => ({ __step: String(step) }));

    // Umami event tracking (analytics loads PROD-only, so guard with ?.).
    const track = (name: string, data?: Record<string, string>) =>
      (window as unknown as { umami?: { track: (n: string, d?: Record<string, string>) => void } })
        .umami?.track(name, data);
    let startedTracked = false;

    // Budget filter: the chosen budget can't realistically cover the chosen type.
    function budgetMismatch(): boolean {
      const type = (form.querySelector('input[name="type"]:checked') as HTMLInputElement | null)?.value;
      const budget = (form.querySelector('input[name="budget"]:checked') as HTMLInputElement | null)?.value;
      if (!type || !budget) return false;
      return (priceCheck.types?.[type] ?? 0) > (priceCheck.ceilings?.[budget] ?? Infinity);
    }

    function updateUI() {
      wizard!.dataset.step = String(step);
      if (step <= lastInputStep) saveDraft();

      // Show the budget notice from the timeline step onward (not on the done step).
      if (budgetWarnEl) {
        budgetWarnEl.hidden = !(budgetMismatch() && step >= 2 && step <= lastInputStep);
      }

      fieldsets.forEach((fs) => {
        const idx = parseInt(fs.dataset.step ?? '-1', 10);
        if (idx === step) fs.removeAttribute('hidden');
        else fs.setAttribute('hidden', '');
      });

      progressSteps.forEach((el, i) => {
        el.style.opacity = i <= step ? '1' : '0.7';
        const dot = el.querySelector<HTMLElement>('.brief-progress-dot');
        if (!dot) return;
        if (i < step) {
          dot.style.background = 'var(--accent)';
          dot.style.color = 'var(--ink)';
          dot.style.borderColor = 'var(--ink)';
          dot.textContent = '✓';
        } else if (i === step) {
          dot.style.background = 'var(--ink)';
          dot.style.color = 'var(--bg)';
          dot.style.borderColor = 'var(--ink)';
          dot.textContent = String(i + 1);
        } else {
          dot.style.background = 'transparent';
          dot.style.color = 'var(--ink)';
          dot.style.borderColor = 'var(--ink)';
          dot.textContent = String(i + 1);
        }
      });

      progressLines.forEach((el, i) => {
        el.style.background = i < step ? 'var(--accent)' : 'color-mix(in srgb, var(--ink) 22%, transparent)';
      });

      if (step > lastInputStep) {
        if (navWrap) navWrap.style.display = 'none';
      } else {
        if (navWrap) navWrap.style.display = '';
        if (backBtn) backBtn.disabled = step === 0;
        if (step === lastInputStep) {
          if (nextBtn) nextBtn.hidden = true;
          if (submitBtn) submitBtn.hidden = false;
        } else {
          if (nextBtn) nextBtn.hidden = false;
          if (submitBtn) submitBtn.hidden = true;
        }
      }
    }

    // Validate the current step with our own inline messages. Returns true when
    // the step is complete; otherwise shows the message(s) and focuses the
    // first problem.
    function validateStep(): boolean {
      const fs = wizard!.querySelector<HTMLFieldSetElement>(`.brief-step[data-step="${step}"]`);
      if (!fs) return false;
      const choice = fs.querySelector<HTMLElement>('[data-choice]');
      if (choice) {
        const name = choice.dataset.choice!;
        const checked = fs.querySelector(`input[name="${name}"]:checked`);
        const firstRadio = fs.querySelector<HTMLInputElement>(`input[name="${name}"]`);
        if (!checked && firstRadio) {
          // Anchor the message to the option group, announce it, focus first option.
          choice.id ||= `brief-choice-${name}`;
          setFieldError(choice, msgs[`${name}Required`] || '');
          firstRadio.focus();
          return false;
        }
        clearFieldError(choice);
        return true;
      }
      const fields = Array.from(fs.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('textarea[required], input[required]:not([type="radio"])'));
      const firstInvalid = validateFields(fields, msgs);
      if (firstInvalid) { firstInvalid.focus(); return false; }
      return true;
    }

    const errorEl = wizard.querySelector<HTMLElement>('[data-error]');

    function clearError() {
      if (errorEl) { errorEl.hidden = true; errorEl.textContent = ''; }
    }

    // Scroll the top of the form back into view (below the sticky header) and
    // move focus to the new question without a second, jumpy browser scroll.
    const formTop = wizard.querySelector<HTMLElement>('.brief-progress') ?? wizard;
    function focusStepHeading() {
      const heading = wizard!.querySelector<HTMLElement>(`.brief-step[data-step="${step}"] .brief-q, .brief-step[data-step="${step}"] .brief-done-title`);
      scrollIntoViewSoft(formTop);
      heading?.focus({ preventScroll: true });
    }

    function goNext() {
      if (!validateStep()) return;
      clearError();
      if (step < lastInputStep) {
        step++;
        updateUI();
        focusStepHeading();
        if (step === 1 && !startedTracked) {
          startedTracked = true;
          track('brief-started');
        }
      }
    }

    nextBtn?.addEventListener('click', goNext);

    backBtn?.addEventListener('click', () => {
      if (step > 0) {
        clearError();
        step--;
        updateUI();
        focusStepHeading();
      }
    });

    // Single-choice steps advance on their own when an option is picked with
    // the pointer (short pause so the selection is seen). Keyboard arrows only
    // move the selection — Enter/Space or "Continue" advances — so moving
    // through options never skips a step by accident.
    let pointerPick = false;
    form.addEventListener('pointerdown', (e) => {
      pointerPick = !!(e.target as HTMLElement).closest('.brief-radio, .brief-tile');
    });
    let autoTimer: number | undefined;
    form.addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement;
      if (input.type !== 'radio') return;
      const group = input.closest<HTMLElement>('[data-choice]');
      if (group) clearFieldError(group);
      if (!pointerPick) return;
      pointerPick = false;
      window.clearTimeout(autoTimer);
      const from = step;
      autoTimer = window.setTimeout(() => { if (step === from) goNext(); }, 280);
    });
    form.addEventListener('keydown', (e) => {
      const t = e.target as HTMLInputElement;
      if (e.key === 'Enter' && t.type === 'radio') {
        e.preventDefault();
        if (!t.checked) t.checked = true;
        goNext();
      }
    });

    let sending = false;
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      // Double-submit guard: Enter in a field or a second click while sending.
      if (sending) return;
      if (step !== lastInputStep) return;
      if (!validateStep()) return;
      sending = true;

      const data = new FormData(form);
      const val = (k: string) => (data.get(k) ?? '').toString().trim();
      const subjectPrefix = wizard!.dataset.subjectPrefix || 'New brief from lopatka.sk';
      const payload = {
        access_key: wizard!.dataset.w3fKey || '',
        subject: `${subjectPrefix} — ${val('name') || val('email') || 'dopyt'}`,
        from_name: val('name') || 'lopatka.sk',
        replyto: val('email'),
        // Honeypot: present only when a bot checked it; Web3Forms rejects those.
        botcheck: (data.get('botcheck') ?? '').toString(),
        'Typ projektu': val('type'),
        'Rozpočet': val('budget'),
        Timeline: val('timeline'),
        Popis: val('description'),
        Meno: val('name'),
        Email: val('email'),
        Firma: val('company') || '—',
      };

      if (errorEl) { errorEl.hidden = true; errorEl.textContent = ''; }
      const sendingLabel = wizard!.dataset.sending || 'Odosielam…';
      let originalLabel = '';
      if (submitBtn) {
        originalLabel = submitBtn.textContent ?? '';
        submitBtn.disabled = true;
        submitBtn.textContent = sendingLabel;
        submitBtn.setAttribute('aria-busy', 'true');
      }
      form.setAttribute('aria-busy', 'true');

      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || !json.success) throw new Error(json.message || 'submit failed');
        clearDraft(draftKey);
        form.removeAttribute('aria-busy');
        step = lastInputStep + 1;
        updateUI();
        focusStepHeading();
        // Non-PII props only (project type / budget bucket / timeline).
        track('brief-submitted', {
          type: val('type'),
          budget: val('budget'),
          timeline: val('timeline'),
        });
      } catch {
        if (errorEl) {
          const email = wizard!.dataset.contactEmail || '';
          const tmpl = wizard!.dataset.error || 'Nepodarilo sa odoslať. Skúste to znova.';
          errorEl.textContent = tmpl.replace('{email}', email);
          errorEl.hidden = false;
        }
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = originalLabel;
          submitBtn.removeAttribute('aria-busy');
        }
        form.removeAttribute('aria-busy');
        sending = false;
      }
    });

    textarea?.addEventListener('input', () => {
      if (charCounter) charCounter.textContent = String(textarea.value.length);
    });

    updateUI();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBriefWizard);
  } else {
    initBriefWizard();
  }
  document.addEventListener('astro:page-load', initBriefWizard);
</script>
