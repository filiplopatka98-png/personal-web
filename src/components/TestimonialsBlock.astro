---
import Reveal from './Reveal.astro';
import { t, type Lang } from '../i18n';
import data from '../data/reviews.json';

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const sk = lang === 'sk';

const MAX = 6;
const MIN_STARS = 4; // na kartách len 4★ a viac; odznak s priemerom je vždy skutočný z Google
const reviews = data.reviews
  .filter((r) => r.rating >= MIN_STARS)
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, MAX);

const fmtDate = (iso: string) => {
  const [y, m, d] = iso.split('-').map(Number);
  return sk
    ? `${d}. ${m}. ${y}`
    : new Date(Date.UTC(y, m - 1, d)).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
};
const stars = (n: number) => '★'.repeat(Math.round(n));
const ratingLabel = data.rating.toFixed(1).replace('.', sk ? ',' : '.');
const countLabel = sk
  ? `${data.count} ${data.count === 1 ? 'recenzia' : data.count < 5 ? 'recenzie' : 'recenzií'}`
  : `${data.count} ${data.count === 1 ? 'review' : 'reviews'}`;

const L = sk
  ? { title: 'Čo hovoria klienti.', onGoogle: 'na Google', more: 'Čítať celú recenziu', less: 'Zbaliť', all: 'Všetky recenzie na Google →', write: 'Napísať recenziu', note: 'Recenzie z Google, zobrazené v plnom znení. Aktualizované automaticky.', original: 'Pôvodné znenie v slovenčine', jaspravim: '32 hodnotení · 100 % spokojnosť na Jaspravim.sk', aria: `${ratingLabel} z 5 hviezdičiek, ${countLabel} na Google` }
  : { title: 'What clients say.', onGoogle: 'on Google', more: 'Read full review', less: 'Collapse', all: 'All reviews on Google →', write: 'Write a review', note: 'Reviews from Google, shown in full. Updated automatically.', original: 'Original in Slovak', jaspravim: '32 reviews · 100 % satisfaction on Jaspravim.sk', aria: `${ratingLabel} out of 5 stars, ${countLabel} on Google` };
---
<section class="reviews" data-reviews>
  <Reveal>
    <p class="eyebrow">{t('home.testimonialsEyebrow', lang)}</p>
  </Reveal>

  <Reveal>
    <div class="reviews-head">
      <h2 class="reviews-title display">{L.title}</h2>
      <a class="g-badge" href={data.profileUrl} target="_blank" rel="noopener noreferrer" aria-label={L.aria}>
        <span class="g-score display">{ratingLabel}</span>
        <span class="g-meta">
          <span class="g-stars" aria-hidden="true">{stars(data.rating)}</span>
          <span class="g-label">{countLabel} <span>{L.onGoogle}</span></span>
        </span>
        <span class="g-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </Reveal>

  <div class="reviews-grid">
    {reviews.map((r, i) => (
      <Reveal delay={i * 0.1}>
        <article class="review">
          <div class="review-stars" role="img" aria-label={sk ? `${r.rating} z 5 hviezdičiek` : `${r.rating} out of 5 stars`}>{stars(r.rating)}</div>
          <p class="review-text is-clamped" id={`review-${r.id}`} lang={r.lang}>{r.text}</p>
          <button class="review-toggle" type="button" aria-expanded="false" aria-controls={`review-${r.id}`} data-more={L.more} data-less={L.less}>
            <span class="lbl">{L.more}</span><span class="ic" aria-hidden="true">+</span>
          </button>
          <div class="review-by">
            <strong>{r.author}</strong>
            <span>Google · {fmtDate(r.date)}{!sk && r.lang === 'sk' ? ` · ${L.original}` : ''}</span>
          </div>
        </article>
      </Reveal>
    ))}
  </div>

  <div class="reviews-foot">
    <span class="foot-note">{L.note}</span>
    <div class="foot-links">
      <a class="b2-btn b2-btn--outline" href={data.profileUrl} target="_blank" rel="noopener noreferrer">{L.all}</a>
      <a class="b2-btn b2-btn--yellow" href={data.writeUrl} target="_blank" rel="noopener noreferrer">{L.write}</a>
    </div>
  </div>

  <a class="reviews-proof" href="https://www.jaspravim.sk/lopatkafilip" target="_blank" rel="noopener noreferrer" data-cursor="hover">
    ★★★★★ {L.jaspravim}&nbsp;<span aria-hidden="true">→</span>
  </a>
</section>

<script>
  // Zbalenie dlhých recenzií len vizuálne — text je v HTML vždy celý.
  // Bez JS je vidieť celý text (clamp sa zapína až cez [data-js]).
  document.querySelectorAll<HTMLElement>('[data-reviews]').forEach((root) => {
    root.setAttribute('data-js', '');
    const cards = [...root.querySelectorAll<HTMLElement>('.review')];

    const measure = () => {
      cards.forEach((card) => {
        const text = card.querySelector<HTMLElement>('.review-text')!;
        const btn = card.querySelector<HTMLButtonElement>('.review-toggle')!;
        if (btn.getAttribute('aria-expanded') === 'true') { btn.classList.add('is-visible'); return; }
        text.classList.add('is-clamped');
        btn.classList.toggle('is-visible', text.scrollHeight > text.clientHeight + 1);
      });
    };

    root.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.review-toggle');
      if (!btn) return;
      const text = document.getElementById(btn.getAttribute('aria-controls')!)!;
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      text.classList.toggle('is-clamped', open);
      btn.querySelector('.lbl')!.textContent = open ? btn.dataset.more! : btn.dataset.less!;
    });

    measure();
    window.addEventListener('load', measure);
    window.addEventListener('resize', measure);
    document.fonts?.ready.then(measure);
  });
</script>

<style>
  .reviews { padding: 96px 56px; position: relative; }
  .reviews-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; flex-wrap: wrap; margin-bottom: 56px; }
  .reviews-title { font-size: clamp(34px, 5vw, 60px); line-height: 1.02; font-weight: 800; letter-spacing: -0.02em; margin: 0; max-width: 14ch; font-family: var(--font-display); }

  .g-badge { display: flex; align-items: center; gap: 20px; border: 2px solid var(--ink); padding: 16px 22px; text-decoration: none; color: var(--ink); background: var(--bg); transition: background .15s; }
  .g-badge:hover { background: var(--accent); }
  .g-score { font-size: 56px; font-weight: 800; line-height: 1; letter-spacing: -0.03em; }
  .g-meta { display: grid; gap: 4px; }
  .g-stars { font-size: 20px; letter-spacing: 2px; line-height: 1; }
  .g-label { font-size: 14px; font-weight: 600; }
  .g-label span { color: var(--ink-faint); font-weight: 500; }
  .g-arrow { font-size: 22px; font-weight: 700; margin-left: 4px; }

  .reviews-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px 48px; align-items: start; }
  .review { border-left: 6px solid var(--accent); padding-left: 24px; }
  .review-stars { font-size: 16px; letter-spacing: 2px; margin-bottom: 14px; }
  .review-text { font-size: 21px; line-height: 1.42; font-weight: 500; letter-spacing: -0.005em; margin: 0; white-space: pre-line; }
  .review-text::before { content: '„'; }
  .review-text::after { content: '“'; }

  [data-js] .review-text.is-clamped { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 5; line-clamp: 5; overflow: hidden; }
  [data-js] .review-text.is-clamped::after { content: none; }

  .review-toggle { display: none; margin-top: 14px; background: none; border: 0; padding: 0 0 2px; font: inherit; font-size: 14px; font-weight: 700; letter-spacing: .02em; color: var(--ink); border-bottom: 2px solid var(--ink); cursor: pointer; }
  .review-toggle.is-visible { display: inline-block; }
  .review-toggle:hover { background: var(--accent); }
  .review-toggle:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; }
  .review-toggle .ic { display: inline-block; margin-left: 6px; transition: transform .2s; }
  .review-toggle[aria-expanded='true'] .ic { transform: rotate(45deg); }

  .review-by { margin-top: 22px; display: grid; gap: 2px; font-size: 15px; }
  .review-by strong { font-weight: 700; }
  .review-by span { color: var(--ink-faint); font-size: 13px; letter-spacing: .02em; }

  .reviews-foot { margin-top: 64px; display: flex; flex-wrap: wrap; gap: 14px 28px; align-items: center; justify-content: space-between; border-top: 2px solid var(--ink); padding-top: 24px; }
  .foot-note { font-size: 13px; color: var(--ink-faint); letter-spacing: .02em; }
  .foot-links { display: flex; gap: 14px; flex-wrap: wrap; }
  .foot-links .b2-btn { padding: 14px 22px; font-size: 16px; }

  .reviews-proof { display: inline-block; margin-top: 28px; font-size: 13px; color: var(--ink); text-decoration: none; border-bottom: 1px solid color-mix(in srgb, var(--ink) 33%, transparent); }

  @media (max-width: 1024px) { .reviews { padding: 72px 32px; } .reviews-grid { gap: 48px 36px; } .review-text { font-size: 19px; } }
  @media (max-width: 768px)  { .reviews { padding: 56px 20px; } .reviews-grid { grid-template-columns: 1fr; gap: 44px; } .review-text { font-size: 18px; } .g-score { font-size: 44px; } }
</style>
