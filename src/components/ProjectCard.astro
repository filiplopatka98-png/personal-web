---
import type { CollectionEntry } from 'astro:content';
import { type Lang } from '../i18n';
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const projectImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/projects/*-hero.png', { eager: true });

export interface Props {
  entry: CollectionEntry<'projects'>;
  lang: Lang;
  /** "home" — smaller card with floating "case study" badge. "work" — full card with year-pill + 3 metrics row. */
  variant?: 'home' | 'work';
}
const { entry, lang, variant = 'home' } = Astro.props;
const { data } = entry;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
// entry.id is "sk/veverka" or "en/veverka" — strip locale prefix
const cleanSlug = entry.id.replace(/^(sk|en)\//, '');
const detailHref = lang === 'sk'
  ? `${baseUrl}/praca/${cleanSlug}/`
  : `${baseUrl}/en/work/${cleanSlug}/`;
const accentColor = `var(--${data.accent})`;
const cover = projectImages[`/src/assets/projects/${cleanSlug}-hero.png`]?.default ?? null;
---
<a href={detailHref} class:list={['proj', `is-${variant}`]} data-cursor="hover">
  <div class="proj-cover" style={`background:${accentColor}`}>
    {cover ? (
      <Picture
        src={cover}
        alt={`${data.name} — náhľad webu`}
        widths={[480, 800, 1200]}
        sizes="(max-width: 768px) calc(100vw - 32px), 50vw"
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        class="proj-cover-img"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="proj-cover-label">/{cleanSlug}.png</div>
    )}
    {variant === 'home' && (
      data.metrics[0] ? (
      <div class="proj-cover-stamp">
        <span class="proj-stamp-num">{data.metrics[0].value.includes('→') ? (
          <><span aria-hidden="true">{data.metrics[0].value}</span><span class="visually-hidden">{(lang === 'sk' ? 'z ' : 'from ') + data.metrics[0].value.replace('→', lang === 'sk' ? 'na' : 'to')}</span></>
        ) : data.metrics[0].value}</span>
        <span class="proj-stamp-label">{data.metrics[0].label}</span>
      </div>
    ) : null
    )}
    {variant === 'work' && (
      <div class="proj-cover-pill">↗ {data.year}</div>
    )}
  </div>
  <div class="proj-meta">
    <div>
      <h3 class="proj-name display">{data.name}</h3>
      <div class="proj-kind mono">{(data.kind + (variant === 'work' ? ` · ${data.role}` : '')).replace(/ · /g, '\u00a0· ')}</div>
    </div>
    {variant === 'home' && (
      <div class="proj-year mono">{data.year}</div>
    )}
  </div>
  {variant === 'work' && data.metrics.length > 0 && (
    <div class="proj-metrics mono">
      {data.metrics.slice(0, 3).map((m) => (
        <div><span class="proj-metric-num display">{m.value}</span>{m.label}</div>
      ))}
    </div>
  )}
</a>

<style>
  .proj {
    display: block;
    text-decoration: none;
    color: var(--ink);
    border-top: 0;
    padding-top: 0;
  }

  .proj-cover {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-card);
    position: relative;
    overflow: hidden;
    border: 2px solid var(--ink);
  }
  /* B2: home cards sit on the brand yellow, regardless of per-project accent. */
  .proj.is-home .proj-cover { background: var(--accent) !important; overflow: visible; }

  .proj-cover-stamp {
    position: absolute;
    right: 18px;
    bottom: -34px;
    width: 128px;
    height: 128px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--ink);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 12px;
    box-sizing: border-box;
    gap: 4px;
    z-index: 2;
  }
  .proj-stamp-num {
    font-weight: 900;
    font-stretch: 75%;
    font-size: 26px;
    line-height: 1;
    white-space: nowrap;
  }
  .proj-stamp-label { font-size: 12px; line-height: 1.15; font-weight: 600; }

  .proj-cover :global(.proj-cover-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 4%;
    transition: transform 0.45s var(--ease-out-soft);
  }
  .proj-cover { transition: transform 0.12s var(--ease-out-soft); }
  .proj-cover-stamp { transition: transform 0.35s var(--ease-out-soft); }
  /* Hover (real pointers only): the screenshot leans in a touch and the yellow
     result stamp turns toward you — the brand circle reacting to the cursor. */
  @media (hover: hover) and (pointer: fine) {
    .proj:hover .proj-cover :global(.proj-cover-img) { transform: scale(1.02); }
    .proj:hover .proj-cover-stamp { transform: scale(1.08) rotate(-8deg); }
    .proj:hover .proj-name { text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 5px; }
  }

  .proj-cover-label {
    position: absolute;
    left: 18px;
    bottom: 18px;
    font-size: 12px;
    color: var(--ink);
    opacity: 0.9;
    font-family: var(--font-mono);
  }

  .proj-cover-badge {
    position: absolute;
    right: 24px;
    top: 24px;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--bg);
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.2;
    text-align: center;
  }

  .proj-cover-pill {
    position: absolute;
    right: 24px;
    top: 24px;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: var(--bg);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .proj-meta {
    display: flex;
    justify-content: space-between;
    margin-top: 18px;
    gap: 16px;
    align-items: baseline;
  }

  .proj-name {
    font-size: 28px;
    line-height: 1.05;
    font-family: var(--font-display);
    font-weight: 800;
  }

  /* Work variant — bigger card (handoff lines 57-69):
     - paddingTop 20→24
     - meta marginTop 18→24
     - name 28→36 */
  .proj.is-work {
    padding-top: 24px;
  }
  .proj.is-work .proj-meta {
    margin-top: 24px;
  }
  .proj.is-work .proj-name {
    font-size: 36px;
  }

  .proj-kind {
    font-size: 15px;
    color: var(--ink-muted);
    margin-top: 8px;
    font-family: var(--font-mono);
  }

  .proj-year {
    font-size: 15px;
    font-weight: 600;
    font-family: var(--font-mono);
  }

  .proj-metrics {
    margin-top: 16px;
    display: flex;
    gap: 24px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: color-mix(in srgb, var(--ink) 72%, var(--bg));
    flex-wrap: wrap;
  }

  .proj-metric-num {
    color: var(--accent-text);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 18px;
    margin-right: 6px;
  }

  @media (max-width: 768px) {
    .proj-cover-stamp { width: 112px; height: 112px; right: 12px; bottom: -28px; padding: 10px; }
    .proj-stamp-num { font-size: 21px; }
    .proj-stamp-label { font-size: 12px; line-height: 1.1; }
    .proj.is-home .proj-meta { padding-right: 112px; }
    .proj.is-work .proj-name { font-size: 28px; }
    .proj-metrics { gap: 16px; }
  }
  @media (max-width: 480px) {
    .proj-name { font-size: 24px; }
    .proj.is-work .proj-name { font-size: 26px; }
  }
</style>
