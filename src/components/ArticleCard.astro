---
import type { CollectionEntry } from 'astro:content';
import { t, type Lang } from '../i18n';

export interface Props {
  entry: CollectionEntry<'articles'>;
  lang: Lang;
}
const { entry, lang } = Astro.props;
const { data } = entry;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const cleanSlug = entry.id.replace(/^(sk|en)\//, '');
const detailHref = lang === 'sk'
  ? `${baseUrl}/blog/${cleanSlug}/`
  : `${baseUrl}/en/blog/${cleanSlug}/`;

const fmt = new Intl.DateTimeFormat(lang === 'sk' ? 'sk-SK' : 'en-US', {
  month: 'short',
  year: 'numeric',
});
const dateStr = fmt.format(data.date);
const readStr = `${data.read} ${t('article.read', lang)}`;
---
<a href={detailHref} class="article-card" data-cursor="hover">
  <div class="article-meta mono">
    <span>{dateStr}</span>
    <span>{readStr}</span>
  </div>
  <h3 class="article-title display">{data.title}</h3>
  <div class="article-cta mono">{t('cta.read', lang)}&nbsp;<span class="arr" aria-hidden="true">→</span></div>
</a>

<style>
  .article-card {
    border-top: 2px solid var(--ink);
    padding-top: 16px;
    display: block;
    text-decoration: none;
    color: var(--ink);
  }

  .article-meta {
    font-size: 14px;
    color: var(--ink-muted);
    display: flex;
    justify-content: space-between;
    margin-bottom: 16px;
    font-family: var(--font-mono);
  }

  .article-title {
    font-size: 26px;
    line-height: 1.1;
    font-family: var(--font-display);
    font-weight: 800;
  }

  .article-cta {
    font-size: 15px;
    font-weight: 700;
    margin-top: 24px;
    /* Solid darker variant for AA contrast on small mono CTA. */
    color: var(--accent-text);
    font-family: var(--font-mono);
  }
</style>
