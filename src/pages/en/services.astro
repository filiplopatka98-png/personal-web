---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import FaqSection from '../../components/FaqSection.astro';
import Reveal from '../../components/Reveal.astro';
import Blob from '../../components/Blob.astro';
import { t } from '../../i18n';
import { getStaticRoute } from '../../i18n/routes';
import { processSteps } from '../../data/process';
import { jsonLd } from '../../utils/jsonld';
import { buildServiceCatalog } from '../../utils/serviceCatalog';
import TrustStats from '../../components/TrustStats.astro';
import PriceCalculator from '../../components/PriceCalculator.astro';

const lang = 'en';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const services = (await getCollection('services'))
  .filter((s) => s.id.startsWith('en/'))
  .sort((a, b) => a.data.order - b.data.order);

const titleHtml = `${t('services.title.before', lang)}<em>${t('services.title.em', lang)}</em>${t('services.title.after', lang)}`;
const steps = processSteps[lang];

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const serviceCatalogLd = buildServiceCatalog(services.map((s) => s.data), {
  name: 'Web development services',
  orgId: `${siteUrl}${baseUrl}/#organization`,
  inLanguage: 'en-US',
});
---
<BaseLayout lang={lang} canonicalPath="/en/services/" altLangUrl="/sluzby/" title="Services — web development, e-commerce, performance audit" description="Packages and pricing: landing page, company website, e-shop and audit. Design, build, deploy and support — focused on performance, SEO and accessibility.">
  <script is:inline slot="head" type="application/ld+json" set:html={jsonLd(serviceCatalogLd)}></script>
  <PageHead
    eyebrow={t('services.eyebrow', lang)}
    titleHtml={titleHtml}
    lead={t('services.lead', lang)}
    blobColor="var(--accent2)"
  />

  <TrustStats locale="en" />

  <PriceCalculator lang="en" />

  <section class="services-section">
    <div class="services-grid">
      {services.map((s, i) => (
        <Reveal delay={(i % 2) * 0.08}>
          <ServiceCard entry={s} lang={lang} index={i + 1} />
        </Reveal>
      ))}
    </div>
  </section>

  <section class="process-section">
    <Blob color="var(--accent3)" size={280} position="bottom: 40px; right: 80px; opacity: 0.5;" />
    <Reveal>
      <div class="process-eyebrow mono">{t('services.processEyebrow', lang)}</div>
      <h2 class="process-title display">{t('services.processTitle', lang)}</h2>
    </Reveal>
    <div class="process-grid">
      {steps.map((step, i) => (
        <Reveal delay={i * 0.05}>
          <div class="process-step">
            <div class="step-num mono">{step.num}</div>
            <div class="step-title display">{step.title}</div>
            <p class="step-desc">{step.desc}</p>
          </div>
        </Reveal>
      ))}
    </div>
  </section>

  {/* Social proof right where the buying decision happens — real client
      testimonial reused from the homepage TestimonialsBlock. */}
  <section class="services-testimonial">
    <Reveal>
      <div class="services-testimonial-eyebrow mono">TESTIMONIAL</div>
      <figure class="services-testimonial-fig">
        <blockquote class="services-testimonial-quote display">„Filip built us a new website and now new customers reach out through it. He delivered on time, and whenever I need a change I just message him and he handles it."</blockquote>
        <figcaption class="services-testimonial-author mono">— Adam Kolarovič, owner of Profi House s.r.o.</figcaption>
      </figure>
    </Reveal>
  </section>

  <FaqSection lang={lang} />

  <section class="services-final-cta">
    <Reveal>
      <h2 class="final-cta-title display">
        {t('services.finalCta.title.before', lang)}<em class="final-cta-em">{t('services.finalCta.title.em', lang)}</em>{t('services.finalCta.title.after', lang)}
      </h2>
      <p class="final-cta-lead">{t('services.finalCta.lead', lang)}</p>
      <a href={`${baseUrl}${getStaticRoute('brief', lang)}`} class="final-cta-btn mono" data-cursor="hover">
        {t('cta.briefStart', lang)} →
      </a>
    </Reveal>
  </section>
</BaseLayout>

<style>
  .services-section {
    padding: 60px 56px;
  }
  .services-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    max-width: 1200px;
    margin: 0 auto;
    align-items: stretch;
  }

  .process-section {
    padding: 80px 56px;
    background: var(--bg2);
    position: relative;
    overflow: hidden;
  }
  .process-eyebrow {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ink-muted);
    margin-bottom: 14px;
    letter-spacing: 0.06em;
    position: relative;
  }
  .process-title {
    font-size: 64px;
    margin: 0 0 48px;
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: -0.02em;
    position: relative;
  }
  .process-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 32px;
    position: relative;
  }
  .process-step {
    border-top: 2px solid var(--accent);
    padding-top: 20px;
  }
  .step-num {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-muted);
    margin-bottom: 8px;
  }
  .step-title {
    font-family: var(--font-display);
    font-size: 28px;
    line-height: 1.1;
    margin-bottom: 12px;
  }
  .step-desc {
    font-size: 14px;
    line-height: 1.55;
    opacity: 0.75;
    margin: 0;
  }

  /* Testimonial strip — slim social-proof band before the FAQ. */
  .services-testimonial {
    padding: 72px 56px;
    background: var(--bg2);
    border-top: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
  }
  .services-testimonial-eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 20px;
  }
  .services-testimonial-fig {
    margin: 0;
    max-width: 820px;
    border-left: 2px solid var(--accent);
    padding-left: 28px;
  }
  .services-testimonial-quote {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 28px;
    line-height: 1.3;
    font-style: italic;
    letter-spacing: -0.01em;
  }
  .services-testimonial-author {
    margin-top: 18px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-muted);
  }

  .services-final-cta {
    padding: 100px 56px;
    text-align: center;
  }
  .final-cta-title {
    font-size: 80px;
    line-height: 1;
    margin: 0 0 16px;
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: -0.02em;
  }
  .final-cta-em {
    color: var(--accent-text);
    font-style: italic;
  }
  .final-cta-lead {
    font-size: 18px;
    opacity: 0.7;
    max-width: 520px;
    margin: 0 auto 32px;
    line-height: 1.5;
  }
  .final-cta-btn {
    display: inline-block;
    background: var(--ink);
    color: var(--bg);
    padding: 16px 28px;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 14px;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .final-cta-btn:hover {
    background: var(--accent);
    color: var(--ink);
  }

  @media (max-width: 1024px) {
    .services-section { padding: 48px 32px; }
    .process-section { padding: 64px 32px; }
    .services-testimonial { padding: 64px 32px; }
    .services-testimonial-quote { font-size: 24px; }
    .services-final-cta { padding: 80px 32px; }
    .services-grid { gap: 28px; }
    .process-grid { grid-template-columns: 1fr 1fr; gap: 28px; }
    .process-title { font-size: 52px; }
    .final-cta-title { font-size: 64px; }
  }
  @media (max-width: 768px) {
    .services-section { padding: 40px 20px; }
    .process-section { padding: 56px 20px; }
    .services-testimonial { padding: 56px 20px; }
    .services-testimonial-quote { font-size: 21px; }
    .services-testimonial-fig { padding-left: 20px; }
    .services-final-cta { padding: 64px 20px; }
    .services-grid { grid-template-columns: 1fr; gap: 24px; }
    .process-grid { grid-template-columns: 1fr; gap: 24px; }
    .process-title { font-size: 38px; }
    .final-cta-title { font-size: 48px; }
    .final-cta-lead { font-size: 16px; }
  }
  @media (max-width: 480px) {
    .services-section { padding: 32px 16px; }
    .process-section { padding: 48px 16px; }
    .services-testimonial { padding: 48px 16px; }
    .services-final-cta { padding: 56px 16px; }
    .process-title { font-size: 32px; }
    .final-cta-title { font-size: 40px; }
  }
</style>
